% === Cover letterspacing helper (XeLaTeX/fontspec) ===
% Usage: \Spaced[0.5em]{國立中央大學}
% Note: fontspec's LetterSpace does not apply to xeCJK CJK fonts reliably.
% This macro inserts a fixed kern between each character/token, so it works for Chinese cover text.
\newcommand{\Spaced}[2][0.5em]{%
  \begingroup
  \def\NCUSpacedKern{#1}%
  \expandafter\NCUSpacedDo\expanded{#2}\relax
  \endgroup
}
\def\NCUSpacedDo#1#2\relax{%
  #1%
  \ifx\relax#2\relax
  \else
    \kern\NCUSpacedKern
    \NCUSpacedDo#2\relax
  \fi
}
$if(beamer)$
$if(background-image)$
\usebackgroundtemplate{%
  \includegraphics[width=\paperwidth]{$background-image$}%
}
% In beamer background-image does not work well when other images are used, so this is the workaround
\pgfdeclareimage[width=\paperwidth,height=\paperheight]{background}{$background-image$}
\usebackgroundtemplate{\pgfuseimage{background}}
$endif$
