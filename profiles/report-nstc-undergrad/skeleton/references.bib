% ============================================================
% 國科會大專學生研究計畫成果報告 — 範例 BibTeX 條目
% ============================================================
% 建議透過 Zotero + Better BibTeX 擴充套件自動匯出此檔案。
% 詳見：docs/03-zotero-setup.md
%
% 引用語法（在 paper.md 中）：
%   [@example-key]                  單一引用
%   [@example-key1; @example-key2]  多篇同時引用
% ============================================================

@inproceedings{example-conference,
  title     = {Example Conference Paper Title},
  author    = {Author, First and Author, Second},
  booktitle = {Proceedings of the Example Conference},
  pages     = {1--10},
  year      = {2024}
}

@article{example-journal,
  title   = {Example Journal Article Title},
  author  = {Author, First and Author, Second},
  journal = {Example Journal},
  volume  = {10},
  number  = {2},
  pages   = {1--15},
  year    = {2024}
}

@online{example-online,
  title   = {Example Online Resource},
  author  = {{Organization Name}},
  url     = {https://example.com/resource},
  urldate = {2026-01-01},
  year    = {2026}
}
